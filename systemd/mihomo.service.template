# 用法：把 <ABS_PATH> 替换成本目录绝对路径，再复制到 /etc/systemd/system/mihomo.service
[Unit]
Description=Mihomo Clash Meta Core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=<ABS_PATH>
Environment="HOME=<ABS_PATH>"
ExecStartPre=/usr/bin/env bash -lc 'cd <ABS_PATH> && ./scripts/install-core.sh && ([ -s config/config.yaml ] || ./update-config.sh)'
ExecStart=<ABS_PATH>/bin/mihomo -d <ABS_PATH>/config
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
